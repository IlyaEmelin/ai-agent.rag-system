# Dataset
DATASET_PATH=filmoskop_kb.json

# Reproducibility
RANDOM_SEED=42

# Local LLM server.
# If the server is OpenAI-compatible, LangChain ChatOpenAI usually expects the /v1 base URL.
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=not-needed-for-local-server
LLM_MODEL_NAME=unsloth/Qwen3.5
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=1024

# Judge model.
# By default, use the same local server/model as the answer generator.
JUDGE_BASE_URL=http://localhost:8080/v1
JUDGE_API_KEY=not-needed-for-local-server
JUDGE_MODEL_NAME=unsloth/Qwen3.5
JUDGE_TEMPERATURE=0
JUDGE_TIMEOUT_SECONDS=120
JUDGE_MAX_TOKENS=1024

# Embeddings
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32
NORMALIZE_EMBEDDINGS=true

# Chroma is used as a local prototype vector store, not as a production database.
CHROMA_PERSIST_DIR=.chroma
CHROMA_COLLECTION_PREFIX=filmoskop

# Chunking defaults. Final values should be justified in the notebook after comparison.
CHUNK_SIZE=900
CHUNK_OVERLAP=150
ALT_CHUNK_SIZE=600
ALT_CHUNK_OVERLAP=100

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_FETCH_K=20
RETRIEVAL_SCORE_THRESHOLD=0.0

# Hybrid retrieval
BM25_ENABLED=true
RRF_ENABLED=true
RRF_K=60

# Reranker. Enable only if local/remote resources are sufficient.
RERANKER_ENABLED=false
# Альтернативный реранкер
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=20
RERANKER_DEVICE=auto

# Answer policy
REFUSAL_PHRASE=В базе знаний нет информации, чтобы надёжно ответить на этот вопрос.